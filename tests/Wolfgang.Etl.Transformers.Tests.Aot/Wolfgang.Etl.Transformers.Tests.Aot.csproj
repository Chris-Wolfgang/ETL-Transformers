<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Native AOT test run (fleet standard, 2026-10-30).

    Runs the SAME unit tests as Wolfgang.Etl.Transformers.Tests.Unit, compiled as a Native AOT
    executable with xUnit v3. The 2.x project stays as it is for every TFM; this one exists only
    to prove the library under trimming + AOT, which a JIT test run cannot.

    The test sources are linked, not copied: fix a test in Tests.Unit and it is fixed here.
    xUnit v3's in-process console runner makes this project its own executable (no
    Microsoft.NET.Test.Sdk), and with PublishAot that executable is a native binary.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Follows Tests.Unit: the repo is multi-targeted, so the linked sources carry explicit usings. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Not a dotnet-test project: build-pr.ps1 runs `dotnet test` only on IsTestProject /
         Microsoft.NET.Test.Sdk projects. This one is published and executed by the AOT job. -->
    <IsTestProject>false</IsTestProject>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- Globalization/GlobalizationInvarianceTests use real cultures (CultureInfo.GetCultureInfo),
         so ICU is required: InvariantGlobalization must stay OFF for this project. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The AOT (source-generated) edition of xUnit.net v3: test discovery, theory data and attribute
         configuration are resolved at build time, so no reflection is needed at run time. The plain
         `xunit.v3` package is reflection-based and cannot run under Native AOT. Requires net9.0+ and C#. -->
    <PackageReference Include="xunit.v3.aot" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wolfgang.Etl.Transformers\Wolfgang.Etl.Transformers.csproj" />
  </ItemGroup>

  <!-- The unit tests themselves, linked from the 2.x project (including the Globalization/ subfolder). -->
  <ItemGroup>
    <Compile Include="..\Wolfgang.Etl.Transformers.Tests.Unit\**\*.cs" Exclude="..\Wolfgang.Etl.Transformers.Tests.Unit\obj\**;..\Wolfgang.Etl.Transformers.Tests.Unit\bin\**" Link="Unit\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
