<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByFile>**/bin/**/*.cs;**/obj/**/*.cs</ExcludeByFile>
          <!--
            Exclude Microsoft.NET.Test.Sdk's auto-generated Program.cs — a
            NuGet-restored trampoline (host entry point) that we don't own and can't
            exercise. It shows up as a 0% class in every test project under
            IncludeTestAssembly=true and drags the reported test-code coverage down
            despite not being test code at all. Class-name pattern rather than file
            pattern because coverlet's ExcludeByFile glob doesn't match .nuget-restored
            paths on all runners.
          -->
          <Exclude>[*]AutoGeneratedProgram</Exclude>
          <ExcludeByAttribute>ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <!--
            Instrument the test assembly itself (#218). Test code is held to 100% line
            coverage: uncovered test code is dead — a helper nobody calls, a fake nobody
            invokes, an unreachable defensive branch — and should be exercised or deleted.
            Without this, the reported coverage summary reflects the src assembly only
            and test-code drift stays invisible.
          -->
          <IncludeTestAssembly>true</IncludeTestAssembly>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
